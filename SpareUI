-- UILib.lua (保存为 ModuleScript)
local UILib = {}
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
if not player then return end
local playerGui = player:WaitForChild("PlayerGui")

-- 创建 ScreenGui
function UILib:CreateScreenGui()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "SimpleUILib"
    screenGui.Parent = playerGui
    screenGui.ResetOnSpawn = false
    return screenGui
end

-- 创建主窗口
function UILib:CreateWindow(title)
    local screenGui = self:CreateScreenGui()
    local mainFrame = Instance.new("Frame")
    mainFrame.Name = "MainWindow"
    mainFrame.Size = UDim2.new(0, 600, 0, 400)
    mainFrame.Position = UDim2.new(0.5, -300, 0.5, -200)
    mainFrame.BackgroundColor3 = Color3.fromRGB(20, 25, 40)
    mainFrame.BorderSizePixel = 0
    mainFrame.Parent = screenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = mainFrame

    -- 左侧导航
    local navFrame = Instance.new("Frame")
    navFrame.Name = "Navigation"
    navFrame.Size = UDim2.new(0, 200, 1, -40)
    navFrame.Position = UDim2.new(0, 0, 0, 40)
    navFrame.BackgroundColor3 = Color3.fromRGB(25, 30, 50)
    navFrame.BorderSizePixel = 0
    navFrame.Parent = mainFrame

    local contentFrame = Instance.new("Frame")
    contentFrame.Name = "Content"
    contentFrame.Size = UDim2.new(1, -200, 1, -40)
    contentFrame.Position = UDim2.new(0, 200, 0, 40)
    contentFrame.BackgroundColor3 = Color3.fromRGB(20, 25, 40)
    contentFrame.BorderSizePixel = 0
    contentFrame.Parent = mainFrame

    local cornerContent = Instance.new("UICorner")
    cornerContent.CornerRadius = UDim.new(0, 10)
    cornerContent.Parent = contentFrame

    local navItems = {}
    local contentPages = {}
    local currentPage = nil

    local function addNavItem(name)
        local navItem = Instance.new("TextButton")
        navItem.Name = name
        navItem.Size = UDim2.new(1, -10, 0, 40)
        navItem.Position = UDim2.new(0, 5, 0, #navItems * 45)
        navItem.BackgroundColor3 = Color3.fromRGB(30, 35, 60)
        navItem.BorderSizePixel = 0
        navItem.Text = name
        navItem.TextColor3 = Color3.fromRGB(150, 150, 150)
        navItem.TextScaled = true
        navItem.Font = Enum.Font.Gotham
        navItem.Parent = navFrame

        local cornerNav = Instance.new("UICorner")
        cornerNav.CornerRadius = UDim.new(0, 5)
        cornerNav.Parent = navItem

        local contentPage = Instance.new("ScrollingFrame")
        contentPage.Name = name .. "Page"
        contentPage.Size = UDim2.new(1, -10, 1, -10)
        contentPage.Position = UDim2.new(0, 5, 0, 5)
        contentPage.BackgroundTransparency = 1
        contentPage.BorderSizePixel = 0
        contentPage.ScrollBarThickness = 6
        contentPage.Visible = false
        contentPage.Parent = contentFrame

        navItem.MouseButton1Click:Connect(function()
            if currentPage then
                currentPage.Visible = false
                navItems[currentPage.Name].BackgroundColor3 = Color3.fromRGB(30, 35, 60)
            end
            currentPage = contentPage
            contentPage.Visible = true
            navItem.BackgroundColor3 = Color3.fromRGB(40, 45, 70)
        end)

        if #navItems == 0 then
            navItem.MouseButton1Click:Connect(navItem.MouseButton1Click)
            currentPage = contentPage
            contentPage.Visible = true
            navItem.BackgroundColor3 = Color3.fromRGB(40, 45, 70)
        end

        table.insert(navItems, navItem)
        contentPages[name] = contentPage
        return contentPage
    end

    local function createCheckbox(parent, text, default, callback)
        local checkboxFrame = Instance.new("Frame")
        checkboxFrame.Size = UDim2.new(1, -20, 0, 30)
        checkboxFrame.BackgroundTransparency = 1
        checkboxFrame.Parent = parent

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -40, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = text
        label.TextColor3 = Color3.fromRGB(200, 200, 200)
        label.TextScaled = true
        label.Font = Enum.Font.Gotham
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = checkboxFrame

        local checkbox = Instance.new("TextButton")
        checkbox.Size = UDim2.new(0, 20, 0, 20)
        checkbox.Position = UDim2.new(1, -30, 0.5, -10)
        checkbox.BackgroundColor3 = default and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(100, 100, 100)
        checkbox.BorderSizePixel = 0
        checkbox.Text = ""
        checkbox.Parent = checkboxFrame

        local cornerCheck = Instance.new("UICorner")
        cornerCheck.CornerRadius = UDim.new(0, 3)
        cornerCheck.Parent = checkbox

        local state = default
        checkbox.MouseButton1Click:Connect(function()
            state = not state
            checkbox.BackgroundColor3 = state and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(100, 100, 100)
            if callback then callback(state) end
        end)

        return checkbox
    end

    local window = {
        MainFrame = mainFrame,
        AddNavItem = addNavItem,
        CreateCheckbox = createCheckbox
    }

    return window
end

return UILib
